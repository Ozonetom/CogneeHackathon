# Copy to .env and fill in. Never commit the real .env (already in .gitignore).

# --- LLM ---
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=

# --- Embeddings (swap these later to change models; the sync engine picks it up automatically) ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Cloud (Qdrant Cloud + Neo4j Aura) — the durable, always-retained store ---
QDRANT_CLOUD_URL=
QDRANT_CLOUD_KEY=
NEO4J_CLOUD_URL=
NEO4J_CLOUD_USER=
NEO4J_CLOUD_PASS=

# --- Local (Docker Qdrant + Docker Neo4j) — rolling backup, last LOCAL_RETENTION_DAYS only ---
QDRANT_LOCAL_URL=http://localhost:6333
QDRANT_LOCAL_KEY=
NEO4J_LOCAL_URL=bolt://localhost:7687
NEO4J_LOCAL_USER=neo4j
NEO4J_LOCAL_PASS=localpassword

# --- Sync tuning ---
LOCAL_RETENTION_DAYS=14
SYNC_MIN_INTERVAL_HOURS=12
CONNECTIVITY_TIMEOUT_SECONDS=5

# --- Slack bot (bot.py only) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
